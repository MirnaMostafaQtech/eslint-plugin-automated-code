{
  "$schema": "http://json-schema.org/schema",
  "$id": "AutomatedCodeDocsNgAdd",
  "title": "Automated Code Documentation ng-add options",
  "type": "object",
  "properties": {
    "skipVscode": {
      "type": "boolean",
      "default": false,
      "description": "Do not touch .vscode/extensions.json or .vscode/settings.json."
    },
    "skipInstall": {
      "type": "boolean",
      "default": false,
      "description": "Add eslint-plugin-jsdoc to package.json without running npm install."
    }
  }
}
